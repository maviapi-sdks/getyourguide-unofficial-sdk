{
  "openapi": "3.1.0",
  "info": {
    "title": "GetYourGuide API",
    "version": "2026-11-20",
    "description": "Tour & activity listings from GetYourGuide — prices, ratings, availability dates and destinations, plus per-activity detail and bulk sitemap discovery.\n\nEvery request needs an API key in the `Authorization: Bearer <key>` header. Create one at https://maviapi.com/dashboard/keys. A successful request uses one credit, unless its operation says more (`x-credits`). That price covers 200 rows (or the operation's `x-credits-rows`); a request that returns more pays it again for each further page of that many rows. The `x-maviapi-credits` response header says what a request cost.\n\nEndpoint reference with live examples: https://maviapi.com/apis/getyourguide",
    "termsOfService": "https://maviapi.com/terms"
  },
  "externalDocs": {
    "description": "API page",
    "url": "https://maviapi.com/apis/getyourguide"
  },
  "servers": [
    {
      "url": "https://api.maviapi.com/v1/sites/getyourguide"
    }
  ],
  "security": [
    {
      "maviapiKey": []
    }
  ],
  "paths": {
    "/activities/{location}": {
