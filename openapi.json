                            "integer",
                            "null"
                          ],
                          "example": 16
                        },
                        "activities": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "927092"
                              },
                              "title": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "Venice: St. Mark's Basilica, Doge's Palace & Bridge of Sighs"
                              },
                              "url": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "https://www.getyourguide.com/venice-l35/venice-st-mark-s-basilica-doge-s-palace-bridge-of-sighs-t927092/"
