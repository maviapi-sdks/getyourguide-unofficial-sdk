                              "rating_count": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "example": 4122
                              },
                              "available_from": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "description": "Next availability datetime (ISO 8601)",
                                "example": "2026-08-14T09:00:00+02:00"
                              },
                              "location": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "Venice"
                              },
                              "image": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "https://cdn.getyourguide.com/img/tour/....jpg/68.jpg"
